{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "paths": {
      "@agent-town/shared": ["./shared/src/index.ts"],
      "@agent-town/shared/data-dir": ["./shared/src/data-dir.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "dashboard"]
}
